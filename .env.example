# [SERVER]
SERVER_PORT=3000
# The public url to access the server from
SERVER_URL=https://sub.domain.tld

# [CLIENT]
CLIENT_PORT=8080
# The API endpoint that the client will use
# This gets injected at build time so if changed you will need to rebuild the client container
CLIENT_API_HOST=${SERVER_URL}/api

# [SERVER_INTERNAL]
# The values below should not need to be changed!
# They are simply here for testing purposes
# SERVER_API_ENDPOINT=https://ap.webuntis.com/WebUntis/api/rest/view/v1
# SERVER_API_SCHOOL=ap
# SERVER_INTERNAL_HOST=0.0.0.0
# SERVER_INTERNAL_PORT=3000