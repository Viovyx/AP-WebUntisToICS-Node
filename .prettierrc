{
    "$schema": "https://www.schemastore.org/prettierrc",
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "trailingComma": "none",
    "printWidth": 80,
    "overrides": [
        {
            "files": "*.yml",
            "options": {
                "useTabs": true,
                "tabWidth": 2
            }
        }
    ]
}
